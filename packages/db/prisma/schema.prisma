generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["ride"]
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  DRIVER
  RIDER
  MERCHANT
  ADMIN

  @@schema("ride")
}

enum VehicleType {
  SEDAN
  MINIVAN
  BAKKIE
  SCOOTER
  BICYCLE
  /// A 15-seat minibus taxi: the vehicle most event group trips need (Phase 3).
  MINIBUS

  @@schema("ride")
}

enum RideStatus {
  REQUESTED
  ACCEPTED
  DRIVER_ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@schema("ride")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED

  @@schema("ride")
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  EN_ROUTE
  DELIVERED
  FAILED

  @@schema("ride")
}

enum PaymentMethod {
  CASH
  CARD
  YOCO
  OZOW
  WALLET

  @@schema("ride")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED

  @@schema("ride")
}

// ─────────────────────────────────────────────
// Users & Profiles
// ─────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  phone         String   @unique
  email         String?  @unique
  name          String
  avatar        String?
  role          UserRole @default(CUSTOMER)
  isVerified    Boolean  @default(false)
  isActive      Boolean  @default(true)
  walletBalance Decimal  @default(0) @db.Decimal(10, 2)

  // Named `fcmToken` until it was noticed that it never held an FCM token — the
  // apps register through Expo's push service and store an `ExponentPushToken[…]`.
  // Expo relays to FCM on Android, so the old name described the last hop rather
  // than the value. Renamed in the schema; `@map` keeps the existing column so
  // `prisma db push` does not drop it. `pushProvider` records which transport the
  // stored token belongs to.
  pushToken    String? @map("fcmToken")
  pushProvider String  @default("expo") // expo | fcm

  // Copied into every token at sign-in and compared on every request. Bumping it
  // signs the user out everywhere at once: after a role change, a suspension, or
  // a stolen phone. Without it a 30-day token outlives every decision made about
  // the account it belongs to.
  tokenVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driverProfile   Driver?
  riderProfile    Rider?
  merchantProfile Merchant?

  rides             Ride[]             @relation("CustomerRides")
  orders            Order[]            @relation("CustomerOrders")
  ratingsGiven      Rating[]           @relation("RaterRatings")
  ratingsReceived   Rating[]           @relation("RateeRatings")
  notifications     Notification[]
  payments          Payment[]
  tripRequests      TripRequest[]
  operatorDocuments OperatorDocument[]
  ledgerEntries     LedgerEntry[]

  @@schema("ride")
}

model Driver {
  id            String @id @default(cuid())
  userId        String @unique
  user          User   @relation(fields: [userId], references: [id])
  licenseNumber String @unique

  // A South African ID number is never stored as itself. `idNumberEnc` holds it
  // encrypted (AES-256-GCM, see packages/db/src/crypto.ts), `idNumberHash` is a
  // keyed hash so a duplicate registration can still be refused, and
  // `idNumberLast4` is the only part any screen shows. Nullable because the
  // number is captured at operator onboarding, not at sign-up.
  idNumberEnc   String?
  idNumberHash  String? @unique
  idNumberLast4 String?

  isOnline   Boolean  @default(false)
  isApproved Boolean  @default(false)
  currentLat Float?
  currentLng Float?
  heading    Float?
  rating     Float    @default(0)
  totalRides Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  vehicle      Vehicle?
  rides        Ride[]
  earnings     DriverEarning[]
  groupTrips   GroupTrip[]     @relation("GroupTripDriver")
  counterTrips GroupTrip[]     @relation("GroupTripCounter")

  @@schema("ride")
}

model Rider {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  // Same treatment as Driver: encrypted, a keyed hash for uniqueness, last four.
  idNumberEnc     String?
  idNumberHash    String?  @unique
  idNumberLast4   String?
  isOnline        Boolean  @default(false)
  isApproved      Boolean  @default(false)
  currentLat      Float?
  currentLng      Float?
  rating          Float    @default(0)
  totalDeliveries Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vehicle    Vehicle?
  deliveries Delivery[]
  earnings   RiderEarning[]

  @@schema("ride")
}

model Vehicle {
  id           String      @id @default(cuid())
  driverId     String?     @unique
  riderId      String?     @unique
  driver       Driver?     @relation(fields: [driverId], references: [id])
  rider        Rider?      @relation(fields: [riderId], references: [id])
  type         VehicleType
  make         String
  model        String
  year         Int
  color        String
  licensePlate String      @unique
  /// Passenger seats, set when the vehicle is approved. Null means the type's
  /// usual count (packages/db/src/trips.ts).
  seats        Int?
  isApproved   Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@schema("ride")
}

// ─────────────────────────────────────────────
// Ride-Hailing
// ─────────────────────────────────────────────

model Ride {
  id              String        @id @default(cuid())
  customerId      String
  customer        User          @relation("CustomerRides", fields: [customerId], references: [id])
  driverId        String?
  driver          Driver?       @relation(fields: [driverId], references: [id])
  pickupLat       Float
  pickupLng       Float
  pickupAddress   String
  dropoffLat      Float
  dropoffLng      Float
  dropoffAddress  String
  status          RideStatus    @default(REQUESTED)
  vehicleType     String        @default("SEDAN")
  fareEstimate    Decimal       @db.Decimal(10, 2)
  fareActual      Decimal?      @db.Decimal(10, 2)
  distanceKm      Float         @default(0)
  durationMinutes Int?
  paymentMethod   PaymentMethod @default(CASH)
  scheduledAt     DateTime?
  acceptedAt      DateTime?
  arrivedAt       DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  cancelledBy     String? // CUSTOMER | DRIVER | ADMIN
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  locations RideLocation[]
  payment   Payment?
  rating    Rating?
  earning   DriverEarning?

  @@schema("ride")
}

model RideLocation {
  id        String   @id @default(cuid())
  rideId    String
  ride      Ride     @relation(fields: [rideId], references: [id])
  lat       Float
  lng       Float
  speed     Float?
  timestamp DateTime @default(now())

  @@schema("ride")
}

// ─────────────────────────────────────────────
// Marketplace & Delivery
// ─────────────────────────────────────────────

model Merchant {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id])
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  stores Store[]

  @@schema("ride")
}

/// A shopping complex or mall: the unit the platform is sold to (docs/PLAN.md §1,
/// Phase 2.2). Its stores share one delivery zone and one delivery fee, so a
/// customer pays the same to have a loaf of bread or a phone charger brought from
/// the same mall.
model Complex {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  address          String
  lat              Float
  lng              Float
  /// Orders are delivered within this distance of the complex, straight-line.
  /// Further than a scooter can sensibly ride is refused at checkout, not
  /// discovered by a rider halfway there.
  deliveryRadiusKm Float    @default(8)
  /// What the customer pays for delivery from any store in the complex.
  deliveryFee      Decimal  @default(20) @db.Decimal(10, 2)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  stores Store[]

  @@schema("ride")
}

model Store {
  id           String   @id @default(cuid())
  merchantId   String
  merchant     Merchant @relation(fields: [merchantId], references: [id])
  /// Optional: a stand-alone shop keeps its own delivery fee and no radius.
  complexId    String?
  complex      Complex? @relation(fields: [complexId], references: [id])
  name         String
  description  String?
  phone        String
  address      String
  lat          Float
  lng          Float
  logoUrl      String?
  bannerUrl    String?
  isOpen       Boolean  @default(false)
  isApproved   Boolean  @default(false)
  openTime     String?
  closeTime    String?
  deliveryFee  Decimal  @default(15) @db.Decimal(10, 2)
  minimumOrder Decimal  @default(0) @db.Decimal(10, 2)
  rating       Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categories StoreCategory[]
  products   Product[]
  orders     Order[]

  @@index([complexId])
  @@schema("ride")
}

model StoreCategory {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  name      String
  iconUrl   String?
  createdAt DateTime @default(now())

  products Product[]

  @@schema("ride")
}

model Product {
  id          String         @id @default(cuid())
  storeId     String
  store       Store          @relation(fields: [storeId], references: [id])
  categoryId  String?
  category    StoreCategory? @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  price       Decimal        @db.Decimal(10, 2)
  imageUrl    String?
  isAvailable Boolean        @default(true)
  stock       Int?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  orderItems OrderItem[]

  @@schema("ride")
}

model Order {
  id              String        @id @default(cuid())
  customerId      String
  customer        User          @relation("CustomerOrders", fields: [customerId], references: [id])
  storeId         String
  store           Store         @relation(fields: [storeId], references: [id])
  status          OrderStatus   @default(PENDING)
  subtotal        Decimal       @db.Decimal(10, 2)
  deliveryFee     Decimal       @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  deliveryAddress String
  deliveryLat     Float
  deliveryLng     Float
  notes           String?
  paymentMethod   PaymentMethod @default(CASH)
  confirmedAt     DateTime?
  preparedAt      DateTime?
  readyAt         DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  cancelledBy     String? // CUSTOMER | MERCHANT | ADMIN
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items    OrderItem[]
  delivery Delivery?
  payment  Payment?
  rating   Rating?
  earning  RiderEarning?

  @@schema("ride")
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  totalPrice Decimal  @db.Decimal(10, 2)
  notes      String?
  createdAt  DateTime @default(now())

  @@schema("ride")
}

model Delivery {
  id               String         @id @default(cuid())
  orderId          String         @unique
  order            Order          @relation(fields: [orderId], references: [id])
  riderId          String?
  rider            Rider?         @relation(fields: [riderId], references: [id])
  status           DeliveryStatus @default(PENDING)
  distanceKm       Float?
  estimatedMinutes Int?
  /// The 4-digit code the customer gives the rider at the door, encrypted
  /// (packages/db/src/crypto.ts). Encrypted rather than hashed because the
  /// customer's app must show it; only the customer's view ever decrypts it, and
  /// the rider's never carries it. Without it, "delivered" was whatever the rider
  /// tapped (threat model OD-4, PLAN.md Phase 2.5).
  handoverCodeEnc  String?
  /// Wrong codes entered. At the limit the delivery can no longer be completed by
  /// code, so four digits cannot be guessed at the door.
  handoverAttempts Int            @default(0)
  assignedAt       DateTime?
  pickedUpAt       DateTime?
  enRouteAt        DateTime?
  deliveredAt      DateTime?
  failedAt         DateTime?
  failReason       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  locations DeliveryLocation[]

  // The dispatch list reads waiting deliveries (no rider, status PENDING) on
  // every refresh of every online rider's app.
  @@index([status, riderId])
  @@schema("ride")
}

model DeliveryLocation {
  id         String   @id @default(cuid())
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id])
  lat        Float
  lng        Float
  timestamp  DateTime @default(now())

  @@schema("ride")
}

// ─────────────────────────────────────────────
// Payments & Earnings
// ─────────────────────────────────────────────

model Payment {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  rideId     String?       @unique
  ride       Ride?         @relation(fields: [rideId], references: [id])
  orderId    String?       @unique
  order      Order?        @relation(fields: [orderId], references: [id])
  amount     Decimal       @db.Decimal(10, 2)
  method     PaymentMethod
  status     PaymentStatus @default(PENDING)
  reference  String?       @unique
  gatewayRef String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@schema("ride")
}

model DriverEarning {
  id         String   @id @default(cuid())
  driverId   String
  driver     Driver   @relation(fields: [driverId], references: [id])
  rideId     String   @unique
  ride       Ride     @relation(fields: [rideId], references: [id])
  amount     Decimal  @db.Decimal(10, 2)
  commission Decimal  @db.Decimal(10, 2)
  net        Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  @@schema("ride")
}

model RiderEarning {
  id         String   @id @default(cuid())
  riderId    String
  rider      Rider    @relation(fields: [riderId], references: [id])
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id])
  amount     Decimal  @db.Decimal(10, 2)
  commission Decimal  @db.Decimal(10, 2)
  net        Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  @@schema("ride")
}

// ─────────────────────────────────────────────
// Ratings & Notifications
// ─────────────────────────────────────────────

model Rating {
  id        String   @id @default(cuid())
  raterId   String
  rater     User     @relation("RaterRatings", fields: [raterId], references: [id])
  rateeId   String
  ratee     User     @relation("RateeRatings", fields: [rateeId], references: [id])
  rideId    String?  @unique
  ride      Ride?    @relation(fields: [rideId], references: [id])
  orderId   String?  @unique
  order     Order?   @relation(fields: [orderId], references: [id])
  score     Int
  comment   String?
  createdAt DateTime @default(now())

  @@schema("ride")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  type      String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@schema("ride")
}

// ─────────────────────────────────────────────
// Config & Admin
// ─────────────────────────────────────────────

model PricingConfig {
  id                 String   @id @default(cuid())
  name               String   @unique
  baseFare           Decimal  @db.Decimal(10, 2)
  perKmRate          Decimal  @db.Decimal(10, 2)
  perMinuteRate      Decimal  @db.Decimal(10, 2)
  minimumFare        Decimal  @db.Decimal(10, 2)
  platformFeePercent Float    @default(15)
  isActive           Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@schema("ride")
}

model DeliveryZone {
  id          String   @id @default(cuid())
  name        String
  description String?
  feeAmount   Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("ride")
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  // HMAC-SHA256 of the code under a server-held key, never the code itself. A
  // plain hash would not help: six digits are a million guesses, so anyone who
  // read this table could reverse an unkeyed hash in seconds.
  codeHash  String
  // Wrong guesses against this code. It is burned at the limit, so a code cannot
  // be brute-forced however the requests are spread across addresses.
  attempts  Int      @default(0)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@schema("ride")
}

/// Who did what, when — for admin actions, sign-ins, status changes and anything
/// touching money (PRACTICES.md SEC-4). Rows are only ever inserted.
model AuditLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  actorUserId String?
  actorRole   String?
  action      String // e.g. ride.accept, order.status, auth.otp.verify.fail
  entityType  String // e.g. Ride, Order, User
  entityId    String?
  ip          String?
  detail      Json?

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@schema("ride")
}

// ─────────────────────────────────────────────
// Events and group trips (docs/PLAN.md Phase 3)
// ─────────────────────────────────────────────

enum VenueKind {
  RESORT
  CLUB
  HALL
  SPORTS
  OTHER

  @@schema("ride")
}

/// A partner venue: a resort, club or hall that sends us its events' posters.
/// The agreement is recorded as a date and a note: what was agreed, with whom.
model Venue {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  kind          VenueKind @default(OTHER)
  address       String
  lat           Float
  lng           Float
  /// The venue's business contact. Admin only; never on a public page.
  contactName   String?
  contactPhone  String?
  agreementAt   DateTime?
  agreementNote String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  events Event[]

  @@schema("ride")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED

  @@schema("ride")
}

/// An event at a venue. A draft is seen by admins only; publishing puts it on the
/// public page that is shared to Facebook.
model Event {
  id           String      @id @default(cuid())
  venueId      String
  venue        Venue       @relation(fields: [venueId], references: [id])
  title        String
  slug         String      @unique
  description  String?
  startsAt     DateTime
  endsAt       DateTime?
  ticketInfo   String?
  status       EventStatus @default(DRAFT)
  /// The poster, re-written without its metadata (camera, location, author) and
  /// capped at 2 MB. In the database, not a bucket: a few posters a month do not
  /// justify a storage service before there is a cloud account to hold one.
  posterBytes  Bytes?
  posterType   String?
  posterSha256 String?
  publishedAt  DateTime?
  createdById  String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  spends       EventSpend[]
  visits       EventVisit[]
  tripRequests TripRequest[]
  groupTrips   GroupTrip[]
  modelCalls   ModelCall[]

  @@index([status, startsAt])
  @@schema("ride")
}

/// Money spent promoting an event (a Meta boost), so the funnel can say whether
/// the fees an event earned covered what it cost (PLAN.md §4, step 10).
model EventSpend {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id])
  channel      String // META | OTHER
  amount       Decimal  @db.Decimal(10, 2)
  spentOn      DateTime
  note         String?
  recordedById String
  createdAt    DateTime @default(now())

  @@index([eventId])
  @@schema("ride")
}

/// One view of a public event page, by channel (fb, wa, sms, direct). No IP, no
/// user, no cookie: counting is all the funnel needs.
model EventVisit {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  channel   String
  createdAt DateTime @default(now())

  @@index([eventId, channel])
  @@schema("ride")
}

/// A published pickup point: a taxi rank, plaza or garage. Group trips leave from
/// public places, never a passenger's home (threat model PL-4).
model PickupPoint {
  id        String   @id @default(cuid())
  name      String
  address   String
  lat       Float
  lng       Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  requests   TripRequest[]
  groupTrips GroupTrip[]

  @@schema("ride")
}

enum TripDirection {
  TO_EVENT
  FROM_EVENT

  @@schema("ride")
}

enum TripRequestStatus {
  /// Asked for seats; waiting for an operator.
  WAITING
  /// An operator countered; this passenger has not answered yet.
  CONFIRMING
  /// An operator has the trip at a price this passenger agreed to.
  BOOKED
  BOARDED
  NO_SHOW
  COMPLETED
  /// The passenger turned down a counter.
  DECLINED
  CANCELLED

  @@schema("ride")
}

/// One passenger's request for seats to (or from) an event, at the price per seat
/// they offered. Pooled with others leaving the same point into a group trip.
model TripRequest {
  id             String            @id @default(cuid())
  eventId        String
  event          Event             @relation(fields: [eventId], references: [id])
  customerId     String
  customer       User              @relation(fields: [customerId], references: [id])
  pickupPointId  String
  pickupPoint    PickupPoint       @relation(fields: [pickupPointId], references: [id])
  direction      TripDirection     @default(TO_EVENT)
  seats          Int
  pricePerSeat   Decimal           @db.Decimal(10, 2)
  status         TripRequestStatus @default(WAITING)
  groupTripId    String?
  groupTrip      GroupTrip?        @relation(fields: [groupTripId], references: [id])
  /// Where the passenger came from (fb, wa, direct), for the funnel.
  channel        String?
  /// The passenger's boarding code, encrypted; the operator enters it at pickup.
  checkInCodeEnc String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  /// One request per passenger per event and direction: more seats means
  /// changing the request, not stacking requests to crowd a trip.
  @@unique([eventId, customerId, direction])
  @@index([groupTripId])
  @@schema("ride")
}

enum GroupTripStatus {
  OPEN
  COUNTERED
  BOOKED
  COMPLETED
  CANCELLED

  @@schema("ride")
}

/// Passengers going to one event from one pickup point at one time, offered to
/// operators as one job (PLAN.md §4, lane 1b).
model GroupTrip {
  id                  String          @id @default(cuid())
  eventId             String
  event               Event           @relation(fields: [eventId], references: [id])
  pickupPointId       String
  pickupPoint         PickupPoint     @relation(fields: [pickupPointId], references: [id])
  direction           TripDirection   @default(TO_EVENT)
  departAt            DateTime
  status              GroupTripStatus @default(OPEN)
  driverId            String?
  driver              Driver?         @relation("GroupTripDriver", fields: [driverId], references: [id])
  /// One counter per trip: the operator who made it holds the trip until the
  /// passengers answer or the counter expires.
  counterDriverId     String?
  counterDriver       Driver?         @relation("GroupTripCounter", fields: [counterDriverId], references: [id])
  counterPricePerSeat Decimal?        @db.Decimal(10, 2)
  counteredAt         DateTime?
  counterExpiresAt    DateTime?
  bookedAt            DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  /// Keyed hash of the passengers' share link token; the token itself is never stored.
  shareTokenHash      String?         @unique
  /// The fee rate when the trip was booked, so a later change does not reprice it.
  platformFeePercent  Float?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  requests TripRequest[]

  @@index([eventId, status])
  @@schema("ride")
}

enum OperatorDocumentKind {
  DRIVING_PERMIT
  OPERATING_LICENCE
  VEHICLE_LICENCE
  INSURANCE

  @@schema("ride")
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED

  @@schema("ride")
}

/// A document an operator must hold to take group trips (PLAN.md 3.7). Recorded
/// and checked by an admin against the paper; nothing approves itself.
model OperatorDocument {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id])
  kind           OperatorDocumentKind
  /// The document's number, encrypted; only its last four characters are shown.
  referenceEnc   String
  referenceLast4 String
  expiresOn      DateTime?
  status         DocumentStatus       @default(PENDING)
  note           String?
  verifiedById   String?
  verifiedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([userId, kind])
  @@schema("ride")
}

enum LedgerKind {
  /// Our share of a completed trip or delivery, owed by the operator.
  FEE_DUE
  /// A payment from the operator towards what they owe.
  FEE_PAID
  /// A correction by an admin, signed: positive adds to what is owed.
  ADJUSTMENT

  @@schema("ride")
}

/// What operators owe us, as events (AGENTS.md rule 3). A balance is always the
/// sum of these rows, never a stored number. Rows are only ever inserted.
model LedgerEntry {
  id             String     @id @default(cuid())
  operatorUserId String
  operator       User       @relation(fields: [operatorUserId], references: [id])
  kind           LedgerKind
  amount         Decimal    @db.Decimal(10, 2)
  /// RIDE | DELIVERY | GROUP_TRIP | PAYMENT | MANUAL
  sourceType     String
  sourceId       String?
  note           String?
  recordedById   String?
  createdAt      DateTime   @default(now())

  /// A trip's fee is recorded once, however many times completion is retried.
  @@unique([kind, sourceType, sourceId])
  @@index([operatorUserId, createdAt])
  @@schema("ride")
}

// ─────────────────────────────────────────────
// Language-model calls (docs/PLAN.md Phase 4, ADR 0008)
// ─────────────────────────────────────────────

enum ModelCallOutcome {
  /// The model answered and its answer passed the checks (some fields may be set aside).
  OK
  /// The model answered, and the answer was discarded whole.
  INVALID
  /// No answer: refused, timed out, no credentials, or the call failed.
  ERROR

  @@schema("ride")
}

/// One call to a language model, kept whatever happened (PRACTICES ML-7): what
/// it cost in time, tokens and money, under which prompt version. For a poster
/// read it also holds the checked proposal, which reaches an event only when an
/// admin applies it to a draft. The model's raw answer is not kept: what an
/// admin needs is the proposal and what was set aside, with the reason.
model ModelCall {
  id            String           @id @default(cuid())
  /// "poster.read"
  feature       String
  model         String
  promptVersion String
  latencyMs     Int
  inputTokens   Int?
  outputTokens  Int?
  /// US dollars at the configured price; null when no price is configured.
  costUsd       Decimal?         @db.Decimal(12, 6)
  outcome       ModelCallOutcome
  errorKind     String?
  eventId       String?
  event         Event?           @relation(fields: [eventId], references: [id])
  posterSha256  String?
  /// The fields that survived the checks, cleaned.
  proposal      Json?
  /// Fields withheld from the proposal: { field, reason, excerpt }[].
  setAside      Json?
  /// Why the answer was discarded or the call failed, in words for the admin.
  problem       String?
  requestedById String
  appliedAt     DateTime?
  appliedById   String?
  createdAt     DateTime         @default(now())

  @@index([createdAt])
  @@index([eventId, createdAt])
  @@schema("ride")
}
