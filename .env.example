# ─── Database ────────────────────────────────────────────────
# Supabase connection pooler (Transaction mode — for Next.js)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase direct connection (for Prisma Migrate)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ─── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ─── Auth / JWT ──────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-at-least-32-chars"
JWT_SECRET="your-jwt-secret-at-least-32-chars"

# ─── Google Maps Platform ────────────────────────────────────
# TWO SEPARATE KEYS. This split is the whole security design — do not merge them.
#
# 1. SERVER KEY — Geocoding, Routes, Places. These SKUs bill per request, so this
#    key must never reach a client bundle. Note the absence of a NEXT_PUBLIC_
#    prefix: Next.js only exposes variables to the browser when they carry it.
#    Restrict it in the Cloud console by API, and by the API server's egress IP.
GOOGLE_MAPS_SERVER_KEY="your-server-side-google-maps-api-key"
GOOGLE_MAPS_REGION="ZA"

# 2. APP KEYS — Maps SDK rendering only, one per platform. These ship inside the
#    app binaries by design and are extractable from any APK; that is acceptable
#    because the Maps SDK for Android/iOS SKU is free at unlimited volume, so a
#    stolen copy costs nothing. Restrict each to the Maps SDK APIs only and to the
#    app's package name / bundle ID.
#    Read by apps/{customer,driver}-app/app.config.js.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY="your-android-maps-sdk-key"
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY="your-ios-maps-sdk-key"

# Where the Expo apps find the API. Defaults to 10.0.2.2:3000 on the Android
# emulator and localhost:3000 on iOS; set this for a physical device or a
# deployed backend.
# EXPO_PUBLIC_API_URL="http://192.168.1.20:3000"

# ─── Push Notifications ──────────────────────────────────────
# Two transports, selected per token by shape (see packages/push-service).
#
# EXPO — used by Expo Go builds, which register an ExponentPushToken[…]. Expo
# relays to FCM/APNs for us. The access token is optional and only needed if the
# Expo project has enhanced push security enabled.
EXPO_PUSH_ACCESS_TOKEN="your-expo-push-access-token"

# FCM — used once a development/EAS build issues native registration tokens.
# The whole service-account JSON on one line. Escaped "\n" inside private_key is
# handled automatically. Leave unset and the FCM transport disables itself
# cleanly; Expo keeps working.
#
# NEVER commit a real value. In production this belongs in Secret Manager, not
# in an env file — see docs/gcp-architecture.md.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"…","client_email":"…","private_key":"-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----\n"}'

# ─── BigQuery Analytics ──────────────────────────────────────
# Both must be set for analytics to do anything. Unset, every write is a silent
# no-op and the dashboard says so explicitly rather than rendering zeros.
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
BIGQUERY_DATASET="ride_analytics"
BIGQUERY_LOCATION="africa-south1"

# Keys customer and driver ids before they reach BigQuery. Without it those
# columns are written as NULL rather than as an unsalted hash — hashing a known
# id space without a secret is reversible, and emitting one would be a false
# assurance of anonymity.
ANALYTICS_HASH_SALT="a-long-random-secret-never-committed"

# Ceiling on a single BigQuery call (default 10000). Credential discovery hangs
# rather than failing when ADC is unavailable, and these writes are not awaited.
# BIGQUERY_TIMEOUT_MS="10000"

# Authentication is Application Default Credentials. On Cloud Run that is the
# attached service account and there is no key file anywhere. Locally, use
# `gcloud auth application-default login` — do not create a service-account key.

# ─── Payments (South Africa) ─────────────────────────────────
YOCO_SECRET_KEY="your-yoco-secret-key"
YOCO_PUBLIC_KEY="your-yoco-public-key"

# ─── API ─────────────────────────────────────────────────────
# Internal API key used between mobile apps and the backend
API_SECRET_KEY="your-internal-api-secret"

# ─── Misc ────────────────────────────────────────────────────
NODE_ENV="development"
